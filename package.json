{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run --workspaces --if-present build",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run --workspaces --if-present typecheck",
    "dev:builder-card": "npm run dev --workspace=@workspace/builder-card",
    "dev:api-server": "npm run dev --workspace=@workspace/api-server",
    "dev:mockup-sandbox": "npm run dev --workspace=@workspace/mockup-sandbox"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
