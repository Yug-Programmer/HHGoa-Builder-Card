{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd $(git rev-parse --show-toplevel) && npm install",
  "buildCommand": "cd $(git rev-parse --show-toplevel) && npm run build",
  "outputDirectory": "../builder-card/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/cards/:id",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
